# Google Sign-In — create an OAuth Client ID in Google Cloud Console.
# Add the exact app origin to Authorized JavaScript origins for local dev.
# Usually one or both of these:
#   http://localhost:5175
#   http://127.0.0.1:5175
GOOGLE_CLIENT_ID=

# Production / Vercel: Neon Postgres connection string from Vercel Marketplace.
DATABASE_URL=

# Optional local SQLite DB path. Defaults to ./.data/budget.sqlite
BUDGET_DB_PATH=

# Recommended for local development: use the deployed API as the single source
# of truth for login, PIN, preferences, service settings and transactions.
BUDGET_API_ORIGIN=https://your-deployment.vercel.app

# Optional server-only merchant enrichment. When configured, Google Places is
# preferred for phone/address/website lookups. Never expose this as a VITE_ key.
GOOGLE_PLACES_API_KEY=

# Optional Nominatim-compatible fallback origin. The public OpenStreetMap
# service is used by default and is queried only after explicit user action.
MERCHANT_LOOKUP_ORIGIN=https://nominatim.openstreetmap.org
